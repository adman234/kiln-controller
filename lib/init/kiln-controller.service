# Template - install.sh fills in @USER@ and @DIR@ and copies this to
# /etc/systemd/system/kiln-controller.service
[Unit]
Description=Kiln controller
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
# Type=notify + WatchdogSec: the control loop reports every cycle. If it
# stops for 90 seconds systemd restarts the service and a firing in
# progress resumes. A second freeze within the safety wait stops the
# firing (Settings -> Safety).
Type=notify
NotifyAccess=main
WatchdogSec=90
TimeoutStartSec=120
User=@USER@
Group=@USER@
WorkingDirectory=@DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=@DIR@/venv/bin/python @DIR@/kiln-controller.py
# remember why the service stopped (e.g. "watchdog"), for the alert sent
# when the firing resumes
ExecStopPost=-/bin/sh -c 'echo "$SERVICE_RESULT $(date +%%s)" > @DIR@/storage/last-exit'
# the web UI's "restart controller" and software update exit and rely on this
Restart=always
RestartSec=5
# the control loop matters more than anything else on this little computer
Nice=-5
# hardening that does not get in the way of GPIO/SPI access
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
