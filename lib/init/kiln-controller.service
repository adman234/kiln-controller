# Template - install.sh fills in @USER@ and @DIR@ and copies this to
# /etc/systemd/system/kiln-controller.service
[Unit]
Description=Kiln controller
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=@DIR@/venv/bin/python @DIR@/kiln-controller.py
# the web UI's "restart controller" and software update exit and rely on this
Restart=always
RestartSec=5
# the control loop matters more than anything else on this little computer
Nice=-5
# hardening that does not get in the way of GPIO/SPI access
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
