#!/usr/bin/env sh

echo "----------------------------------------------"
echo "| Writing all kiln logs to ./kiln.logs.gz... |"
echo "----------------------------------------------"
# modern Raspberry Pi OS logs to the systemd journal, older ones to /var/log
{
  journalctl -u kiln-controller --no-pager -o short-iso 2>/dev/null
  zcat -f /var/log/* 2>/dev/null | strings | grep -E "(INFO|WARN|ERROR) (oven|kiln-controller|gevent)"
} | sort | uniq | gzip > kiln.logs.gz

ls -la kiln.logs.gz
